{
  "product_name": "禁卫网络数字资产安全运营平台",
  "short_name": "禁卫安全运营平台",
  "version": "V1.0",
  "ui_style": "deep-blue-enterprise",
  "css_variables": {
    "--color-primary": "#021452",
    "--color-primary-light": "#1a3a7a",
    "--color-bg-main": "#0a1628",
    "--color-bg-card": "#0f1f3d",
    "--color-bg-sidebar": "#061230",
    "--color-text-primary": "#e0e6f0",
    "--color-text-secondary": "#8899bb",
    "--color-accent": "#2196f3",
    "--color-danger": "#f44336",
    "--color-warning": "#ff9800",
    "--color-success": "#4caf50",
    "--font-family": "PingFang SC, Microsoft YaHei, sans-serif",
    "--font-size-base": "14px",
    "--font-size-sm": "12px",
    "--font-size-lg": "16px",
    "--font-size-xl": "20px",
    "--border-radius": "4px",
    "--sidebar-width": "240px",
    "--header-height": "56px"
