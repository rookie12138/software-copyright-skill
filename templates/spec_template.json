      "name": "首页",
      "route": "/dashboard",
      "icon": "home",
      "enabled": true,
      "sub_modules": []
    },
    {
      "id": "asset",
      "name": "资产中心",
      "route": "/asset",
      "icon": "server",
      "enabled": true,
      "sub_modules": [
        { "id": "host-asset", "name": "主机资产" },
        { "id": "web-asset", "name": "网站资产" },
        { "id": "traffic-risk", "name": "流量风险" },
        { "id": "attack-surface", "name": "攻击面" }
      ]
    },
    {
      "id": "host-risk",
      "name": "主机风险",
      "route": "/host-risk",
      "icon": "shield",
      "enabled": true,
      "sub_modules": [
        { "id": "vuln-ledger", "name": "风险台账" },
        { "id": "vuln-scan", "name": "漏洞扫描" },
        { "id": "scheduled-scan", "name": "周期漏扫" },
        { "id": "config-audit", "name": "配置核查" }
      ]
    },
    {
      "id": "web-risk",
      "name": "网站风险",
      "route": "/web-risk",
      "icon": "globe",
      "enabled": true,
      "sub_modules": [
        { "id": "web-ledger", "name": "网站台账" },
        { "id": "web-vuln-scan", "name": "漏洞扫描" },
        { "id": "web-monitor", "name": "安全监测" },
        { "id": "pentest", "name": "渗透测试" }
      ]
    },
    {
      "id": "attack",
      "name": "攻击事件",
      "route": "/attack",
      "icon": "crosshair",
      "enabled": true,
      "sub_modules": [
        { "id": "monitor-center", "name": "监测中心" },
        { "id": "whitelist", "name": "白名单" },
        { "id": "block-policy", "name": "阻断策略" },
