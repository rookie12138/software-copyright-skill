        { "id": "threat-alerts", "name": "威胁告警", "note": "8类威胁类别" },
        { "id": "honeypot", "name": "蜜罐配置", "note": "6类蜜罐" }
      ]
    },
    {
      "id": "system",
      "name": "系统管理",
      "route": "/system",
      "icon": "settings",
      "enabled": true,
      "sub_modules": [
        { "id": "sys-config", "name": "系统配置" },
        { "id": "sys-upgrade", "name": "在线升级" },
        { "id": "sys-diagnose", "name": "诊断工具" },
        { "id": "probe-deploy", "name": "探针部署" },
        { "id": "param-mgmt", "name": "参数管理" },
        { "id": "op-log", "name": "操作日志" },
        { "id": "linkage-policy", "name": "联动策略" }
